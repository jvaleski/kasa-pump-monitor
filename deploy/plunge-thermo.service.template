[Unit]
Description=Cold plunge thermostat logger (Inkbird ITC-308-WIFI, read-only)
Documentation=file://__INSTALL_DIR__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__PYTHON__ __INSTALL_DIR__/thermo.py log

# Gaps in the history are gaps in the data the thermal model is fitted from.
Restart=always
RestartSec=30s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=plunge-thermo

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
ReadWritePaths=__INSTALL_DIR__

[Install]
WantedBy=multi-user.target
